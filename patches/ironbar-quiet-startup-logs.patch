             spawn(async move {
-                tokio::signal::ctrl_c()
-                    .await
-                    .expect("should handle SIGTERM");
+                // ctrl_c() alone only catches SIGINT: a plain `kill` (SIGTERM)
+                // took the default action and left the IPC socket behind.
+                let mut sigterm =
+                    tokio::signal::unix::signal(tokio::signal::unix::SignalKind::terminate())
+                        .expect("should handle SIGTERM");
+                tokio::select! {
+                    res = tokio::signal::ctrl_c() => res.expect("should handle SIGINT"),
+                    _ = sigterm.recv() => {}
+                }
 
                 info!("Shutting down");
 
