# wayfire 0.11.0 for the workstations, carrying upstream PR #3171.
#
# nixpkgs-unstable ships 0.10.1. That is not a cosmetic gap: 0.11 replaced the
# blur renderer, moved to wlroots 0.20, and split the plugin/protocol layout. The
# config in home/files/wayfire was generated by 0.11 and several of the fixes in
# docs/wayfire.md depend on 0.11 behaviour, so this branch builds 0.11 instead of
# compromising.
#
# It overrides the nixpkgs derivation rather than copying it: only the version,
# the two dependency pins and the patch differ, so postPatch (the libdrm include
# fix, still needed in 0.11), --sysconfdir, providedSessions and everything else
# keep tracking nixpkgs.
{
  lib,
  wayfire,
  fetchFromGitHub,
  glm,
  libdrm,
  wlroots_0_20,
}: let
  version = "0.11.0";
in
  wayfire.overrideAttrs (old: {
    inherit version;

    src = fetchFromGitHub {
      owner = "WayfireWM";
      repo = "wayfire";
      rev = "v${version}";
      # wf-utils, wf-json, wf-touch and wf-config live in subprojects/ and are
      # pinned by the tag's own submodule commits.
      fetchSubmodules = true;
      hash = "sha256-G6GakEpnqw3xORXP7mr2YoyAEymozV0CYeof+a1Nh74=";
    };

    patches = (old.patches or []) ++ [../patches/wayfire-3171-transformed-outputs.patch];

    # The wf-config subproject needs GLM's headers; nixpkgs' 0.10 derivation did
    # not, because it linked a system wf-config that resolved GLM itself.
    buildInputs = (old.buildInputs or []) ++ [glm];
    # 0.11 needs wlroots 0.20, not the wlroots_0_19 nixpkgs pins for 0.10.
    #
    # wf-config is dropped from the inputs entirely and built from the v0.11.0
    # submodule instead (meson flag flipped below): that is the exact version
    # 0.11 expects, and nixpkgs only has 0.10.0. Keeping both on the closure
    # would leave two libwf-config.so in play, so it is removed rather than
    # shadowed.
    propagatedBuildInputs =
      lib.filter (p: p != null)
      (map (
          p: let
            name = p.pname or "";
          in
            if name == "wlroots"
            then wlroots_0_20
            else if name == "wf-config"
            then null
            else p
        )
        old.propagatedBuildInputs);

    # Three flags are replaced rather than appended to: meson tolerates one value
    # per option, so the nixpkgs originals are filtered out first.
    #  - use_system_wfconfig: off, so the pinned v0.11.0 submodule is used.
    #  - wf-config:tests, wf-touch:tests: off. They pull doctest, which nixpkgs
    #    only puts in nativeCheckInputs when doCheck is on, and subproject unit
    #    tests are not what this branch validates.
    mesonFlags =
      (lib.filter (flag: builtins.match "-D(use_system_wfconfig=.*|wf-(touch|config):tests=.*)" flag == null)
        old.mesonFlags)
      ++ [
        "-Duse_system_wfconfig=disabled"
        # The compositor's own suite, plus the two subprojects': all of them pull
        # doctest and none of them are what this branch validates.
        "-Dtests=disabled"
        "-Dwf-config:tests=disabled"
        "-Dwf-touch:tests=disabled"
      ];

    # libdrm's headers include each other by bare name (xf86drmMode.h pulls in
    # drm.h), so the libdrm/ subdirectory itself has to be on the search path.
    # nixpkgs' 0.10 build never hit this; a 0.11 translation unit does.
    env.NIX_CFLAGS_COMPILE = "-I${lib.getDev libdrm}/include/libdrm";

    # Upstream's unit tests are not what this branch validates: a green build
    # plus a compositor that starts and passes docs/wayfire.md's checklist is.
    doCheck = false;
  })
